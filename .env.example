# ==============================================================================
# SmartLCL Environment Configuration (Template)
# Copy this file to .env and adjust variables as required.
# NEVER commit the real .env file with production credentials to source control.
# ==============================================================================

# Core Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=smartlcl_dev
POSTGRES_USER=smartlcl_admin
POSTGRES_PASSWORD=smartlcl_dev_password

# Database URL (Constructed for test runners and connection drivers)
DATABASE_URL=postgresql://smartlcl_admin:smartlcl_dev_password@localhost:5433/smartlcl_dev

# Role Password Placeholders (For future least-privilege DB roles)
ROLE_APP_PASSWORD=placeholder_app_role_secret
ROLE_ANALYST_PASSWORD=placeholder_analyst_role_secret
ROLE_TRADER_PASSWORD=placeholder_trader_role_secret
ROLE_PROVIDER_PASSWORD=placeholder_provider_role_secret
